@{
    ViewData["Title"] = "Compare Local Market Prices";
}

@await Html.PartialAsync("_PublicNavbar")

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-7">

                <span class="badge rounded-pill text-bg-light p-2 mb-3">
                    Smart Shopping Starts Here
                </span>

                <h1 class="hero-title">
                    Compare Prices.
                    <span>Shop Smarter.</span>
                </h1>

                <p class="hero-text mt-3">
                    Find and compare everyday grocery prices
                    from local markets. MolTol helps you make
                    informed shopping decisions and get better
                    value for your money.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">

                    <a href="#prices" class="btn btn-primary-custom">
                        Explore Prices
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <a asp-area="Identity" asp-page="/Account/Register"
                       class="btn btn-outline-custom">
                        Join MolTol
                    </a>

                </div>

                <p class="text-secondary mt-4 small">
                    <i class="bi bi-check-circle-fill text-primary me-2"></i>
                    Compare everyday essentials across local shops.
                </p>

            </div>

            <div class="col-lg-5">

                <div class="custom-card p-4">

                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                        Find Prices Near You
                    </h5>

                    <p class="text-secondary small">
                        Select your area to explore local market prices.
                    </p>

                    <label class="form-label">Select Your Area</label>

                    <select class="form-select mb-3">
                        <option selected disabled>Choose an area</option>
                        <option>Johar Town</option>
                        <option>Model Town</option>
                        <option>Garden Town</option>
                        <option>Gulberg</option>
                    </select>

                    <a href="#prices" class="btn btn-primary-custom w-100">
                        Explore Market Prices
                    </a>

                    <p class="small text-secondary mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Sample interface for demonstration.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="section-padding" id="categories">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">Explore Product Categories</h2>

            <p class="section-subtitle">
                Find prices for your everyday household essentials.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-basket2"></i>
                    </div>
                    <h6 class="fw-bold">Flour & Grains</h6>
                    <p class="small text-secondary mb-0">Atta, rice and pulses</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-droplet"></i>
                    </div>
                    <h6 class="fw-bold">Cooking Essentials</h6>
                    <p class="small text-secondary mb-0">Oil, ghee and sugar</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-egg"></i>
                    </div>
                    <h6 class="fw-bold">Dairy & Eggs</h6>
                    <p class="small text-secondary mb-0">Milk, eggs and yogurt</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-apple"></i>
                    </div>
                    <h6 class="fw-bold">Fruits & Vegetables</h6>
                    <p class="small text-secondary mb-0">Fresh seasonal produce</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-egg-fried"></i>
                    </div>
                    <h6 class="fw-bold">Meat & Poultry</h6>
                    <p class="small text-secondary mb-0">Chicken and meat</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-cup-hot"></i>
                    </div>
                    <h6 class="fw-bold">Beverages</h6>
                    <p class="small text-secondary mb-0">Tea, coffee and drinks</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-house"></i>
                    </div>
                    <h6 class="fw-bold">Household Items</h6>
                    <p class="small text-secondary mb-0">Cleaning and home supplies</p>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="custom-card text-center">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h6 class="fw-bold">Other Essentials</h6>
                    <p class="small text-secondary mb-0">Everyday necessities</p>
                </div>
            </div>

        </div>

    </div>

</section>

<section class="section-padding bg-white" id="prices">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">Compare Local Market Prices</h2>

            <p class="section-subtitle">
                A preview of how MolTol helps compare everyday products.
            </p>

        </div>

        <div class="table-responsive">

            <table class="table table-bordered bg-white align-middle">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Shop</th>
                        <th>Area</th>
                        <th>Price</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Wheat Flour (1kg)</td>
                        <td>Local Grocery Store</td>
                        <td>Johar Town</td>
                        <td class="price">Rs. 150</td>
                    </tr>

                    <tr>
                        <td>Sugar (1kg)</td>
                        <td>City Mart</td>
                        <td>Model Town</td>
                        <td class="price">Rs. 175</td>
                    </tr>

                    <tr>
                        <td>Cooking Oil (1L)</td>
                        <td>Fresh Mart</td>
                        <td>Gulberg</td>
                        <td class="price">Rs. 560</td>
                    </tr>

                    <tr>
                        <td>Chicken (1kg)</td>
                        <td>Local Meat Shop</td>
                        <td>Garden Town</td>
                        <td class="price">Rs. 620</td>
                    </tr>

                </tbody>

            </table>

        </div>

        <p class="text-secondary small text-center mt-3">
            These prices are illustrative examples for the static website.
        </p>

        <div class="text-center mt-4">

            <a asp-area="Identity" asp-page="/Account/Register"
               class="btn btn-primary-custom">
                Create Account to Participate
            </a>

        </div>

    </div>

</section>

@await Html.PartialAsync("_PublicFooter")
